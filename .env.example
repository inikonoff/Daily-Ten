# ═══════════════════════════════════════════════════════════════════════════
# Daily Ten: все переменные окружения
# Скопируйте в .env для локального запуска; на Render те же имена задаются
# в разделе Environment. Обязательные переменные ниже не закомментированы,
# необязательные закомментированы вместе со значением по умолчанию.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Обязательные ───────────────────────────────────────────────────────────

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# Ключи Groq (console.groq.com). Можно несколько через запятую: при лимитах
# бот переключается на следующий ключ. Без ключей бот не стартует.
GROQ_API_KEYS=

# ─── База данных ────────────────────────────────────────────────────────────
# Бот подключается к Postgres напрямую (asyncpg), поэтому нужна ОДНА переменная:
# строка подключения DATABASE_URL. Переменные SUPABASE_URL и SUPABASE_KEY бот
# НЕ использует (supabase-py в проекте нет), задавать их не нужно.
#
# Локально (Docker):
#   postgresql://postgres:postgres@localhost:5432/daily_ten
# Supabase: Project Settings → Database → Connection string → Session pooler
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   (порт 5432 = Session pooler; порт 6543 = Transaction pooler, тоже работает.)
# Спецсимволы в пароле нужно URL-кодировать (@ → %40, # → %23, / → %2F).
# Прямой host db.<project-ref>.supabase.co на Render free не подходит (только IPv6).
DATABASE_URL=

# ─── Админка ────────────────────────────────────────────────────────────────

# Telegram user id админов через запятую (узнать свой id: @userinfobot).
# Им доступны /admin и экран Settings. Пусто = админов нет.
ADMIN_IDS=

# ─── Сервер /health ─────────────────────────────────────────────────────────

# Порт HTTP-сервера для пингера. На Render подставляется автоматически,
# локально можно не задавать.
# PORT=10000

# ─── Модели Groq (необязательно) ────────────────────────────────────────────
# По умолчанию стоят дешёвые модели (бот пока бесплатный). Смена модели =
# смена переменной и рестарт сервиса, код менять не нужно.

# Основная модель: ответы Mrs. Smith и Session Summary.
# GROQ_MODEL=openai/gpt-oss-20b
# Запасная модель, если основная падает. По умолчанию пусто = без запасной:
# бот работает только на gpt-oss-20b. Пример: GROQ_MODEL_FALLBACK=openai/gpt-oss-120b
# GROQ_MODEL_FALLBACK=
# Лёгкая модель для простых задач (кнопка Translate).
# GROQ_MODEL_LIGHT=openai/gpt-oss-20b
# Глубина «рассуждения» моделей gpt-oss: low, medium или high. Рассуждение
# тратит токены ответа, поэтому по умолчанию low. Если смените GROQ_MODEL на
# модель не из семейства gpt-oss, оставьте значение пустым.
# GROQ_REASONING_EFFORT=low
# Распознавание речи на Groq (Whisper).
# GROQ_STT_MODEL=whisper-large-v3-turbo
# Озвучка ответов (TTS).
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# ─── Значения по умолчанию для переключателей из админки (необязательно) ────
# В боте (/admin → Settings) эти два параметра меняются без рестарта, и
# значение из бота перекрывает значение отсюда.

# Распознавание голосовых: auto = сначала Google, при неудаче Whisper;
# google = только Google; groq = только Whisper.
# STT_PROVIDER=auto
# Голосовые ответы и озвучка Summary. false = всё текстом.
# ENABLE_TTS=true

# ─── Объём контекста в промпте Mrs. Smith (необязательно) ───────────────────
# Уменьшайте, только если упираетесь в лимиты токенов Groq.

# Сколько сообщений текущей сессии идёт в промпт (24 = вся сессия).
# CONTEXT_MESSAGES=24
# Сколько последних заметок учителя (SS4T) о прошлых сессиях идёт в промпт.
# SS4T_CONTEXT=3

# ─── Только для тестов ──────────────────────────────────────────────────────
# Отдельная БД для сценарных тестов pytest. Имя базы ОБЯЗАТЕЛЬНО содержит
# "test": тесты применяют схему и очищают таблицы. Не указывайте боевую БД.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daily_ten_test
