# Telegram
TELEGRAM_BOT_TOKEN=

# Groq (можно несколько ключей через запятую — ротация при лимитах)
GROQ_API_KEYS=

# Postgres — локально (Docker) или Supabase
# Локально:  postgresql://postgres:postgres@localhost:5432/daily_ten
# Supabase (Project Settings → Database → Connection string → Session pooler):
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Спецсимволы в пароле нужно URL-кодировать (@ → %40, # → %23, / → %2F).
# Не используйте прямой host db.<ref>.supabase.co на Render free (IPv6).
DATABASE_URL=

# Admin IDs (Telegram user id, через запятую)
ADMIN_IDS=

# Порт для /health (Render подставляет PORT сам)
PORT=10000

# Модели Groq (необязательно; значения по умолчанию ниже). Смена модели = смена переменной.
# GROQ_MODEL=openai/gpt-oss-120b
# Запасная модель: используется, если основная падает; пусто = без запасной.
# Она же лёгкая модель для перевода.
# GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_STT_MODEL=whisper-large-v3
# false: голосовые ответы и озвучка Summary выключены, всё текстом
# ENABLE_TTS=true

# Объём контекста в промпте МС (необязательно). 24 = вся сессия (ТЗ §5).
# Уменьшайте, только если упираетесь в лимиты токенов Groq.
# CONTEXT_MESSAGES=24
# SS4T_CONTEXT=3

